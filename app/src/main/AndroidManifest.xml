<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloading models is the only thing this app ever uses the network for. Once a model is
         on disk, inference is entirely local and the app works in airplane mode. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Model downloads run in a WorkManager foreground service so a multi-gigabyte transfer is not
         killed when the app is backgrounded. DATA_SYNC is the type for a user-visible file download;
         POST_NOTIFICATIONS lets the ongoing-download notification show on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice notes. Speech recognition runs on-device, so audio never leaves the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Models are gigabytes; a phone that can run one is 64-bit with real RAM. -->
    <uses-feature
        android:name="android.hardware.ram.low"
        android:required="false" />

    <application
        android:name=".AIAgentApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIAgentTestApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AIAgentTestApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager's foreground service ships with no foregroundServiceType, but Android 14+
             rejects setForeground unless the type our download worker requests (dataSync) is a
             subset of the type declared here. Merge it onto the library's <service> declaration. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- WorkManager must NOT auto-initialize: the startup initializer would configure it with
             the default worker factory before AIAgentApplication's Configuration.Provider is ever
             consulted, and every @HiltWorker then fails reflection instantiation
             (NoSuchMethodException: <init>(Context, WorkerParameters)). Removing only this entry
             defers initialization to first use, which picks up the HiltWorkerFactory; the other
             startup initializers (emoji2, lifecycle) keep running as before. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Hands a rendered report to another app. A file:// URI cannot cross an app boundary on
             Android 7+, so sharing a PDF needs a content URI and this is what mints it. Not
             exported: access is granted per-share, for one URI, by the flag on the intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
