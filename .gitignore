# llama.cpp is cloned at build time by tools/fetch_llama_cpp.sh (~200 MB of upstream source, with
# its own .git). It is an input to the build, not part of this repository.
/engine-llamacpp/third_party/

# Generated knowledge graph (~99 MB); rebuilt by /graphify, never reviewed as source.
graphify-out/


__pycache__/
*.pyc

# Android Studio's project files. Nine of these were ignored piecemeal and twelve more were
# tracked, which is the worst of both: every developer's device selection, inspection profile and
# bot settings arrived as a diff, and the ignore list still needed a new line each time the IDE
# invented a file. The whole directory is IDE state, regenerated on any checkout.
.idea/

# Claude Code's project directory. settings.json was tracked to pin the plugins the project
# expects, but it sits beside settings.local.json -- one developer's permission allowlist, which
# changes every session -- and keeping half a directory under version control invites the other
# half in by accident. Agent configuration is not part of the build.
.claude/
